{
  "$defs": {
    "AssetMeta": {
      "additionalProperties": false,
      "description": "A content-addressed file under the project's assets/ folder; keyed by id.",
      "properties": {
        "kind": {
          "description": "What the file is.",
          "enum": [
            "photo",
            "texture",
            "thumbnail"
          ],
          "type": "string"
        },
        "path": {
          "description": "Path relative to the project folder: assets/<sha256>.<ext>.",
          "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the file contents.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "w": {
          "description": "Width in pixels.",
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "h": {
          "description": "Height in pixels.",
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "original_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File name as uploaded."
        }
      },
      "required": [
        "kind",
        "path",
        "sha256",
        "w",
        "h",
        "original_name"
      ],
      "title": "AssetMeta",
      "type": "object"
    },
    "Box": {
      "additionalProperties": false,
      "description": "Axis-aligned box standing on its base.",
      "properties": {
        "type": {
          "const": "box",
          "default": "box",
          "type": "string"
        },
        "size": {
          "description": "[width x, height y, depth z] in metres.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "tsType": "[number, number, number]",
          "type": "array"
        }
      },
      "required": [
        "type",
        "size"
      ],
      "title": "Box",
      "type": "object"
    },
    "Cone": {
      "additionalProperties": false,
      "description": "Upright cone with its base on the ground and apex up.",
      "properties": {
        "type": {
          "const": "cone",
          "default": "cone",
          "type": "string"
        },
        "radius": {
          "description": "Base radius in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height": {
          "description": "Height in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "radius",
        "height"
      ],
      "title": "Cone",
      "type": "object"
    },
    "Cylinder": {
      "additionalProperties": false,
      "description": "Upright cylinder standing on its base.",
      "properties": {
        "type": {
          "const": "cylinder",
          "default": "cylinder",
          "type": "string"
        },
        "radius": {
          "description": "Radius in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height": {
          "description": "Height in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "radius",
        "height"
      ],
      "title": "Cylinder",
      "type": "object"
    },
    "Extrusion": {
      "additionalProperties": false,
      "description": "A 2D profile in the local x/y plane, extruded along z, centred on z = 0.",
      "properties": {
        "type": {
          "const": "extrusion",
          "default": "extrusion",
          "type": "string"
        },
        "profile": {
          "description": "Outline in the local x/y plane; y = 0 is the ground.",
          "items": {
            "description": "Plan point [x, y] in metres.",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "tsType": "[number, number]",
            "type": "array"
          },
          "minItems": 3,
          "type": "array"
        },
        "depth": {
          "description": "Extrusion length along local z in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "profile",
        "depth"
      ],
      "title": "Extrusion",
      "type": "object"
    },
    "FaceOverrides": {
      "additionalProperties": false,
      "description": "Per-face material overrides of one wall; unset faces use the facing room's walls.",
      "properties": {
        "left": {
          "anyOf": [
            {
              "description": "Id of a material in scene.materials.",
              "pattern": "^mat_[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Face on the left of a→b, seen from above."
        },
        "right": {
          "anyOf": [
            {
              "description": "Id of a material in scene.materials.",
              "pattern": "^mat_[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Face on the right of a→b, seen from above."
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "FaceOverrides",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "A surface material; keyed by id in scene.materials.",
      "properties": {
        "name": {
          "description": "Display name.",
          "minLength": 1,
          "type": "string"
        },
        "color": {
          "description": "Base colour, lowercase #rrggbb.",
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        },
        "texture_asset": {
          "anyOf": [
            {
              "description": "Id of an asset in scene.assets.",
              "pattern": "^ast_[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional tileable texture asset."
        },
        "tile_size_m": {
          "default": [
            1.0,
            1.0
          ],
          "description": "Real-world size [u, v] of one texture tile, in metres.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "tsType": "[number, number]",
          "type": "array"
        },
        "roughness": {
          "default": 0.8,
          "description": "PBR roughness, 0-1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "metalness": {
          "default": 0.0,
          "description": "PBR metalness, 0-1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "description": "Origin; 'photo' means an AI texture generated from a photo.",
          "enum": [
            "default",
            "user",
            "agent",
            "photo"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "color",
        "texture_asset",
        "tile_size_m",
        "roughness",
        "metalness",
        "source"
      ],
      "title": "Material",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "description": "A building-level note.",
      "properties": {
        "id": {
          "description": "Note id, prefix 'note_'.",
          "pattern": "^note_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "text": {
          "description": "Note text.",
          "minLength": 1,
          "type": "string"
        },
        "room_ids": {
          "description": "Rooms the note is about, e.g. rooms it mentions.",
          "items": {
            "pattern": "^r_[a-z0-9]+(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "room_ids"
      ],
      "title": "Note",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "description": "A door, window or open passage inside a wall.",
      "properties": {
        "id": {
          "description": "Opening id, prefix 'op_'.",
          "pattern": "^op_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "description": "What fills the hole.",
          "enum": [
            "door",
            "window",
            "passage"
          ],
          "type": "string"
        },
        "offset": {
          "description": "Distance in metres along the wall from end a to the near edge.",
          "minimum": 0,
          "type": "number"
        },
        "width": {
          "description": "Width along the wall in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height": {
          "description": "Height of the hole in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "sill": {
          "default": 0.0,
          "description": "Height of the bottom edge in metres, measured from the higher floor of the rooms on either side of the wall (the threshold level).",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "offset",
        "width",
        "height",
        "sill"
      ],
      "title": "Opening",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "description": "Thin flat vertical panel, front facing local -Z.",
      "properties": {
        "type": {
          "const": "panel",
          "default": "panel",
          "type": "string"
        },
        "width": {
          "description": "Width along local x in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height": {
          "description": "Height along local y in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "width",
        "height"
      ],
      "title": "Panel",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "description": "A photo pinned at the pose it was taken from.",
      "properties": {
        "id": {
          "description": "Pin id, prefix 'pin_'.",
          "pattern": "^pin_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "asset_id": {
          "description": "The photo.",
          "pattern": "^ast_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "position": {
          "description": "Camera position in world metres.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "tsType": "[number, number, number]",
          "type": "array"
        },
        "yaw_deg": {
          "description": "View direction, 0 north, clockwise.",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "pitch_deg": {
          "default": 0.0,
          "description": "Up/down tilt in degrees.",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "fov_deg": {
          "default": 60.0,
          "description": "Vertical field of view in degrees.",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "caption": {
          "default": "",
          "description": "Caption shown with the photo.",
          "type": "string"
        },
        "author": {
          "default": "",
          "description": "Who took the photo.",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year the photo was taken, if known."
        },
        "placed": {
          "description": "False until the pin is positioned in 3D.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "asset_id",
        "position",
        "yaw_deg",
        "pitch_deg",
        "fov_deg",
        "caption",
        "author",
        "year",
        "placed"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Pipe": {
      "additionalProperties": false,
      "description": "Tube along a polyline of local points.",
      "properties": {
        "type": {
          "const": "pipe",
          "default": "pipe",
          "type": "string"
        },
        "path": {
          "description": "Centre-line points in local metres.",
          "items": {
            "description": "World vector [x, y, z] in metres, Y up.",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "tsType": "[number, number, number]",
            "type": "array"
          },
          "minItems": 2,
          "type": "array"
        },
        "radius": {
          "description": "Tube radius in metres.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "elbows": {
          "default": true,
          "description": "Round the bends instead of mitring them.",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "path",
        "radius",
        "elbows"
      ],
      "title": "Pipe",
      "type": "object"
    },
    "PrefabRef": {
      "additionalProperties": false,
      "description": "Reference to a parametric prefab from the prefab registry.",
      "properties": {
        "type": {
          "const": "prefab",
          "default": "prefab",
          "type": "string"
        },
        "prefab": {
          "description": "Prefab name, e.g. 'desk'.",
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Prefab parameters; unset ones use prefab defaults.",
          "type": "object"
        }
      },
      "required": [
        "type",
        "prefab",
        "params"
      ],
      "title": "PrefabRef",
      "type": "object"
    },
    "Roof": {
      "additionalProperties": false,
      "description": "The single roof over the building outline.",
      "properties": {
        "type": {
          "description": "Roof shape.",
          "enum": [
            "flat",
            "shed",
            "hip",
            "gable"
          ],
          "type": "string"
        },
        "pitch_deg": {
          "default": 0.0,
          "description": "Slope in degrees (0-70); ignored for flat roofs.",
          "maximum": 70,
          "minimum": 0,
          "type": "number"
        },
        "overhang": {
          "default": 0.3,
          "description": "Eaves overhang beyond the walls, in metres.",
          "minimum": 0,
          "type": "number"
        },
        "base_offset": {
          "default": 0.3,
          "description": "Height of the eaves above the highest ceiling, in metres.",
          "minimum": 0,
          "type": "number"
        },
        "slope_direction_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shed roofs: downhill direction in degrees, 0 north, clockwise."
        },
        "gable_edges": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gable roofs: indices of shell.outline edges that become gable ends (edge i runs from point i to point i+1)."
        },
        "material": {
          "default": "mat_roof_default",
          "description": "Roof covering material.",
          "pattern": "^mat_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "fascia_material": {
          "anyOf": [
            {
              "description": "Id of a material in scene.materials.",
              "pattern": "^mat_[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional fascia material."
        }
      },
      "required": [
        "type",
        "pitch_deg",
        "overhang",
        "base_offset",
        "slope_direction_deg",
        "gable_edges",
        "material",
        "fascia_material"
      ],
      "title": "Roof",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "description": "One room of the shell. Geometry is locked; name, tags, notes, surfaces and ceiling edit.",
      "properties": {
        "id": {
          "description": "Room id, prefix 'r_'.",
          "pattern": "^r_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "name": {
          "description": "Display name, e.g. 'Room 3A'.",
          "minLength": 1,
          "type": "string"
        },
        "tags": {
          "description": "Free-form tags for selectors.",
          "items": {
            "description": "Lowercase free-form tag without '#', e.g. 'corridor' or 'ceiling_mounted'.",
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        "polygon": {
          "description": "Floor outline in plan coordinates.",
          "items": {
            "description": "Plan point [x, y] in metres.",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "tsType": "[number, number]",
            "type": "array"
          },
          "minItems": 3,
          "type": "array"
        },
        "floor_level": {
          "default": 0.0,
          "description": "Floor height in metres; 0 is the entrance level.",
          "maximum": 5,
          "minimum": -5,
          "type": "number"
        },
        "ceiling_height": {
          "default": 2.6,
          "description": "Ceiling height above this room's floor, in metres. At most 8 m and at least the top of every opening in the room's walls + 0.05 m.",
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "type": "number"
        },
        "notes": {
          "description": "Notes, e.g. from Miro stickies.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "surfaces": {
          "$ref": "#/$defs/Surfaces",
          "description": "Surface materials."
        }
      },
      "required": [
        "id",
        "name",
        "tags",
        "polygon",
        "floor_level",
        "ceiling_height",
        "notes",
        "surfaces"
      ],
      "title": "Room",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "description": "An object placed in the scene.",
      "properties": {
        "id": {
          "description": "Object id, prefix 'obj_'.",
          "pattern": "^obj_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "minLength": 1,
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "pattern": "^r_[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Room the object belongs to, if any."
        },
        "tags": {
          "description": "Free-form tags for selectors.",
          "items": {
            "description": "Lowercase free-form tag without '#', e.g. 'corridor' or 'ceiling_mounted'.",
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        "geometry": {
          "description": "Primitive shape or prefab reference.",
          "discriminator": {
            "mapping": {
              "box": "#/$defs/Box",
              "cone": "#/$defs/Cone",
              "cylinder": "#/$defs/Cylinder",
              "extrusion": "#/$defs/Extrusion",
              "panel": "#/$defs/Panel",
              "pipe": "#/$defs/Pipe",
              "prefab": "#/$defs/PrefabRef",
              "sphere": "#/$defs/Sphere"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "$ref": "#/$defs/Cylinder"
            },
            {
              "$ref": "#/$defs/Sphere"
            },
            {
              "$ref": "#/$defs/Cone"
            },
            {
              "$ref": "#/$defs/Pipe"
            },
            {
              "$ref": "#/$defs/Extrusion"
            },
            {
              "$ref": "#/$defs/Panel"
            },
            {
              "$ref": "#/$defs/PrefabRef"
            }
          ]
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "description": "World placement."
        },
        "materials": {
          "additionalProperties": {
            "description": "Id of a material in scene.materials.",
            "pattern": "^mat_[a-z0-9]+(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "description": "Material per slot: 'main' for primitives, prefab-defined slots otherwise.",
          "type": "object"
        },
        "created_by": {
          "description": "Who created it.",
          "enum": [
            "agent",
            "user",
            "import"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "room_id",
        "tags",
        "geometry",
        "transform",
        "materials",
        "created_by"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "Shell": {
      "additionalProperties": false,
      "description": "The locked building shell. Only room metadata and ceiling heights may change after import.",
      "properties": {
        "outline": {
          "description": "Building footprint: the union of all rooms. Roof gable_edges index its edges.",
          "items": {
            "description": "Plan point [x, y] in metres.",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "tsType": "[number, number]",
            "type": "array"
          },
          "minItems": 3,
          "type": "array"
        },
        "default_ceiling_height": {
          "default": 2.6,
          "description": "Ceiling for new rooms.",
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "type": "number"
        },
        "wall_thickness": {
          "$ref": "#/$defs/WallThickness",
          "description": "Default wall thicknesses."
        },
        "facade_material": {
          "default": "mat_facade_default",
          "description": "Material of every exterior wall face.",
